# PORT: Port for Express + Vite server (Defaults to 3000)
PORT="3000"

# NODE_ENV: Set to "production" on Render
NODE_ENV="development"

# CONTACT_WEBHOOK_URL: Optional webhook URL (e.g., Slack, Discord, Formspree, or Make)
# to forward contact form submissions received by POST /api/contact.
CONTACT_WEBHOOK_URL=""

# GEMINI_API_KEY: Optional if extending with AI Studio server routes
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where the portfolio is hosted
APP_URL="MY_APP_URL"
